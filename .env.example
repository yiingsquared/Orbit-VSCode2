# OpenAI connection

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol


# Other providers

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=


# Google sign-in
# Web application OAuth credentials
# Authorized redirect URI uses the exact local server port
# Example http://127.0.0.1:4310/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Optional model defaults

ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_MODEL=deepseek-flash
XAI_MODEL=grok-4.7
PERPLEXITY_MODEL=perplexity/sonar
